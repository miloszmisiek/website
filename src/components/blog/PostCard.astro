---
import type { CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a
  href={`/blog/${post.id}/`}
  class="card-interactive card-hoverable block p-6 md:p-7 no-underline text-inherit"
>
  <span class="text-label">
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
  </span>
  <h2 class="font-display text-heading-md text-2xl mt-2 mb-2.5">{title}</h2>
  <p class="text-body m-0">{description}</p>
  {
    tags.length > 0 && (
      <ul class="flex flex-wrap gap-2 mt-4 m-0 p-0 list-none">
        {tags.map((tag) => (
          <li class="font-mono border border-border text-muted px-2 py-0.5 text-micro tracking-widest uppercase">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</a>
